flowchart TD
    A["Paper PDF<br/>texto científico no estructurado"] --> B["Ingesta y chunking<br/>docling + unidades de contenido"]
    B --> C["OntoCast: razonamiento semántico con LLM<br/>Modelos usados en este repo:<br/>- gpt-5-mini (modo fijo)<br/>- gpt-4o (modo libre)"]
    C --> D["Bucle agentic de refinamiento<br/>render → critique → retry → accept/salvage"]
    D --> E["Normalización semántica / agrupamiento<br/>embeddings + sentence-transformers<br/>UMAP / HDBSCAN en full mode"]
    E --> F{"Modo de trabajo"}

    F --> G["Modo fijo con ontología semilla OPMAD<br/>Razonamiento principal:<br/>alineamiento semántico al vocabulario dado"]
    F --> H["Modo libre / evolución ontológica<br/>Razonamiento principal:<br/>proponer clases, relaciones e instancias"]

    P["Idea clave:<br/>OntoCast aquí NO usa como núcleo<br/>un reasoner DL clásico tipo HermiT/Pellet.<br/>Su núcleo es LLM + crítica iterativa + normalización semántica."]

    C -.-> P
    D -.-> P
    E -.-> P

    classDef input fill:#e8f0fe,stroke:#3465a4,stroke-width:2px,color:#000;
    classDef llm fill:#fff4e5,stroke:#f57900,stroke-width:2px,color:#000;
    classDef semantic fill:#fdebd0,stroke:#c17d11,stroke-width:2px,color:#000;
    classDef fixed fill:#eaf7e6,stroke:#4e9a06,stroke-width:2px,color:#000;
    classDef free fill:#fce5cd,stroke:#b45f06,stroke-width:2px,color:#000;
    classDef note fill:#f9f2ec,stroke:#8a6d3b,stroke-width:1.5px,color:#000;

    class A,B input;
    class C,D,E llm;
    class F semantic;
    class G fixed;
    class H free;
    class P note;
