flowchart TD
    A["Texto de un paper"] --> B["LLM<br/>interpreta lenguaje natural"]
    B --> C["Extrae conceptos, relaciones y hechos"]

    D["Ontología formal + axiomas"] --> E["Reasoner lógico<br/>aplica reglas formales"]
    E --> F["Infiere nuevos hechos"]

    G["Caso nuevo"] --> H["CBR<br/>compara con casos previos"]
    H --> I["Recupera casos similares y soluciones"]

    J["Resumen"]
    C --> J
    F --> J
    I --> J

    classDef llm fill:#fff4e5,stroke:#f57900,stroke-width:2px,color:#000;
    classDef reasoner fill:#e8f0fe,stroke:#3465a4,stroke-width:2px,color:#000;
    classDef cbr fill:#eaf7e6,stroke:#4e9a06,stroke-width:2px,color:#000;
    classDef summary fill:#f5f5f5,stroke:#555,stroke-width:1.5px,color:#000;

    class A,B,C llm;
    class D,E,F reasoner;
    class G,H,I cbr;
    class J summary;
