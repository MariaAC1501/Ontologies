# This repo does not use direct OpenAI API keys.
# Extraction uses the local Pi Codex subscription proxy instead.
# Start it in a separate terminal with:
#   node tools/pi_codex_openai_proxy.mjs

# Optional overrides for the local subscription proxy:
# LLM_BASE_URL=http://127.0.0.1:8977/v1
# PI_CODEX_PROXY_HOST=127.0.0.1
# PI_CODEX_PROXY_PORT=8977
# PI_CODEX_MODEL=gpt-5-mini
# PI_AUTH_FILE=C:\Users\maria\.pi\agent\auth.json
