# Real subscription credentials stay in Pi's auth store.
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-6.1-sol
LLM_BASE_URL=http://127.0.0.1:8787/v1
LLM_API_KEY=local-placeholder

# Start small: extraction and critique loops share your subscription quota.
LLM_MAX_INFLIGHT=1
PARALLEL_WORKERS=1

# Shared per-call timeout for OntoCast and the subscription proxy.
LLM_REQUEST_TIMEOUT_SECONDS=600

# No embedding overrides: keep OntoCast's default local models.
