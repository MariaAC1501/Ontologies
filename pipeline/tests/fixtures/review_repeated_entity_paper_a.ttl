@prefix doc: <urn:review-fixture:repeated:> .
@prefix opmad: <http://www.semanticweb.org/j.montero-jimenez/ontologies/2021/2/OPMAD#> .
@prefix cco: <http://www.ontologyrepository.com/CommonCoreOntologies/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix schema: <https://schema.org/> .

doc:Article a opmad:Predictive_Maintenance_Article ;
    schema:name "Repeated entity paper A" ;
    schema:about doc:SharedModel .

doc:Case a opmad:Predictive_maintenance_case ;
    cco:designates doc:SharedModel .

doc:SharedModel a opmad:Predictive_maintenance_model ;
    schema:name "Repeated model" ;
    schema:monitors doc:SharedPump ;
    obo:RO_0010002 doc:PaperAInput .

doc:SharedPump a opmad:Maintainable_item ;
    schema:name "Repeated pump" .

doc:PaperAInput a opmad:Data_variable ;
    schema:name "Paper A temperature" .
