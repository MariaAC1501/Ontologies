@prefix doc: <urn:review-fixture:one-case:> .
@prefix opmad: <http://www.semanticweb.org/j.montero-jimenez/ontologies/2021/2/OPMAD#> .
@prefix cco: <http://www.ontologyrepository.com/CommonCoreOntologies/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix schema: <https://schema.org/> .

doc:Article a opmad:Predictive_Maintenance_Article ;
    schema:name "One-case article" ;
    schema:about doc:Model .

doc:Case a opmad:Predictive_maintenance_case ;
    cco:designates doc:Model .

doc:Model a opmad:Predictive_maintenance_model,
        opmad:Fault_detection ;
    schema:name "One-case model" ;
    schema:monitors doc:Pump ;
    obo:RO_0010002 doc:Pressure .

doc:Pump a opmad:Maintainable_item ;
    schema:name "Hydraulic pump" .

doc:Pressure a opmad:Data_variable ;
    schema:name "Pressure" .
