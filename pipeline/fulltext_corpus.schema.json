{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ontologies:fulltext-corpus-manifest:1.0",
  "title": "Full-text publication corpus manifest",
  "type": "object",
  "required": [
    "schema_version",
    "base_dir",
    "partition_frozen",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "fulltext-corpus-manifest/1.0"
    },
    "base_dir": {
      "type": "string",
      "minLength": 1
    },
    "partition_frozen": {
      "type": "boolean"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "corpus_id",
        "bibliographic_status",
        "partition",
        "title",
        "doi",
        "year",
        "pdf_path",
        "pdf_sha256"
      ],
      "properties": {
        "corpus_id": {
          "type": "string",
          "minLength": 1
        },
        "bibliographic_status": {
          "enum": [
            "provisional",
            "verified"
          ]
        },
        "partition": {
          "enum": [
            "development",
            "held_out",
            "reserve",
            "unassigned"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "doi": {
          "type": "string",
          "pattern": "^10\\.[0-9]{4,9}/\\S+$"
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "pdf_path": {
          "type": "string",
          "minLength": 1
        },
        "pdf_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "licence": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
