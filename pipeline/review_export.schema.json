{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ontologies:strict-review-export:1.0",
  "title": "Ontologies strict review export record",
  "description": "One nullable, source-document-isolated analytical record. This is not an OPMAD ontology extension.",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "record_status",
    "source_document",
    "article_identity",
    "case_identity",
    "case_article_link",
    "fields",
    "supplementary_evidence"
  ],
  "properties": {
    "schema_version": {"const": "strict-review-export/1.0"},
    "record_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "record_status": {"enum": ["present", "unclear", "extraction_failure"]},
    "source_document": {"$ref": "#/$defs/sourceDocument"},
    "article_identity": {"$ref": "#/$defs/stringField"},
    "case_identity": {"$ref": "#/$defs/stringField"},
    "case_article_link": {"$ref": "#/$defs/caseArticleLink"},
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_year", "task", "case_study", "case_study_type",
        "input_for_model", "number_of_input_variables", "input_types",
        "data_preprocessing", "model_approach", "model_types", "models",
        "module_synchronization", "number_of_failure_modes",
        "performance_indicator", "performance", "complementary_notes",
        "study_title", "publication_identifier"
      ],
      "properties": {
        "publication_year": {"$ref": "#/$defs/yearField"},
        "task": {"$ref": "#/$defs/stringField"},
        "case_study": {"$ref": "#/$defs/stringField"},
        "case_study_type": {"$ref": "#/$defs/stringField"},
        "input_for_model": {"$ref": "#/$defs/stringField"},
        "number_of_input_variables": {"$ref": "#/$defs/countField"},
        "input_types": {"$ref": "#/$defs/stringListField"},
        "data_preprocessing": {"$ref": "#/$defs/booleanField"},
        "model_approach": {"$ref": "#/$defs/stringField"},
        "model_types": {"$ref": "#/$defs/stringListField"},
        "models": {"$ref": "#/$defs/stringListField"},
        "module_synchronization": {"$ref": "#/$defs/stringField"},
        "number_of_failure_modes": {"$ref": "#/$defs/countField"},
        "performance_indicator": {"$ref": "#/$defs/stringListField"},
        "performance": {"$ref": "#/$defs/stringListField"},
        "complementary_notes": {"$ref": "#/$defs/stringField"},
        "study_title": {"$ref": "#/$defs/stringField"},
        "publication_identifier": {"$ref": "#/$defs/stringField"}
      }
    },
    "supplementary_evidence": {
      "type": "object",
      "properties": {
        "design_details": {"$ref": "#/$defs/stringListField"},
        "keywords": {"$ref": "#/$defs/stringField"}
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["type", "message"],
      "properties": {
        "type": {"type": "string"},
        "message": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "status": {
      "enum": ["present", "not_reported", "unclear", "not_applicable", "extraction_failure"]
    },
    "fieldBase": {
      "type": "object",
      "required": ["status", "value", "raw_values", "source_nodes"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "value": {},
        "raw_values": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "source_nodes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "note": {"type": "string"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "present"}}, "required": ["status"]},
          "then": {"properties": {"value": {"not": {"type": "null"}}}},
          "else": {"properties": {"value": {"type": "null"}}}
        }
      ]
    },
    "stringField": {
      "allOf": [
        {"$ref": "#/$defs/fieldBase"},
        {"properties": {"value": {"type": ["string", "null"], "minLength": 1}}}
      ]
    },
    "yearField": {
      "allOf": [
        {"$ref": "#/$defs/fieldBase"},
        {"properties": {"value": {"type": ["integer", "null"], "minimum": 1900, "maximum": 2100}}}
      ]
    },
    "countField": {
      "allOf": [
        {"$ref": "#/$defs/fieldBase"},
        {"properties": {"value": {"type": ["integer", "null"], "minimum": 0}}}
      ]
    },
    "booleanField": {
      "allOf": [
        {"$ref": "#/$defs/fieldBase"},
        {"properties": {"value": {"type": ["boolean", "null"]}}}
      ]
    },
    "stringListField": {
      "allOf": [
        {"$ref": "#/$defs/fieldBase"},
        {"properties": {"value": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}]}}}
      ]
    },
    "sourceDocument": {
      "type": "object",
      "required": ["facts_filename", "facts_path", "source_identity", "document_id", "sha256", "parse_status", "rdf_star_evidence"],
      "properties": {
        "facts_filename": {"type": "string"},
        "facts_path": {"type": "string"},
        "source_identity": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
        "document_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "parse_status": {"enum": ["present", "extraction_failure"]},
        "rdf_star_evidence": {
          "type": "object",
          "required": ["statement_count", "handling"],
          "properties": {
            "statement_count": {"type": "integer", "minimum": 0},
            "handling": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "caseArticleLink": {
      "type": "object",
      "required": ["status", "resolution", "evidence"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "resolution": {"enum": ["resolved", "unresolved", "ambiguous"]},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "candidate_article_iris": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
