LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-5.6-luna
LLM_BASE_URL=http://127.0.0.1:8977/v1
# Non-secret placeholder required by the OpenAI SDK; Pi uses subscription OAuth.
LLM_API_KEY=subscription-proxy
RENDER_MODE=facts
ONTOLOGY_CRITIC_PASSES=0
FACTS_CRITIC_PASSES=1
ONTOCAST_ONTOLOGY_DIRECTORY=pipeline/seed_ontology
ONTOLOGY_CONTEXT_MODE=fixed_single_ontology
ONTOLOGY_CONTEXT_FIXED_ONTOLOGY_ID=http://www.semanticweb.org/j.montero-jimenez/ontologies/2021/2/OPMAD
ONTOLOGY_CONTEXT_REQUIRED=true
PARALLEL_WORKERS=2
MAX_VISITS_PER_NODE=3
# Keep reference-list text too; runners also disable default section exclusions.
CHUNK_BIBLIOGRAPHY_MODE=domain_facts
